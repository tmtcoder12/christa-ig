APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

META_VERIFY_TOKEN=
# Despite the variable name, use the Instagram App Secret from
# Instagram > API setup with Instagram login, not App settings > Basic.
META_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
COMMENT_CLASSIFIER_MODEL=gpt-4o-mini

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VALIDATE_SIGNATURE=true

FOLLOWUP_CRON_SECRET=
FOLLOWUP_DELAY_MINUTES=10
FOLLOWUP_BATCH_SIZE=20

WORKER_POLL_SECONDS=2
WORKER_BATCH_SIZE=10
WORKER_MAX_ATTEMPTS=5
WEBHOOK_FAILURE_RETENTION_DAYS=7
WORKER_LEASE_SECONDS=300
